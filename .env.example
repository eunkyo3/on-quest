# ================================
# On-Quest Environment Variables
# ================================
# Copy this file to .env before running `docker compose up`

# --- Database ---
POSTGRES_USER=onquest
POSTGRES_PASSWORD=onquest_pw
POSTGRES_DB=onquest
POSTGRES_PORT=5432

# Prisma (로컬 backend 실행 시 필수)
DATABASE_URL=postgresql://onquest:onquest_pw@localhost:5432/onquest
JWT_SECRET=change_this_jwt_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# --- n8n ---
# Docker Compose의 n8n 서비스에 포함됨:
# - NODE_FUNCTION_ALLOW_BUILTIN=crypto (Verify HMAC 에서 crypto)
# - N8N_BLOCK_ENV_ACCESS_IN_NODE=false (Verify HMAC 에서 $env.ONQUEST_WEBHOOK_SECRET)
# Task Runner 를 따로 쓰면 해당 컨테이너에도 동일 설정이 필요할 수 있음.
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me

# Shared HMAC secret between NestJS <-> n8n.
# NestJS signs every webhook payload and n8n verifies it in the workflow.
N8N_WEBHOOK_SECRET=super_secret_change_me_in_production

# Slack·외부에서 증빙 파일을 열 수 있는 공개 API 베이스 (글로벌 prefix /api 포함)
# Docker: Slack/n8n이 호스트에서 API에 접근 가능한 URL (예: http://host.docker.internal:3000/api)
API_PUBLIC_URL=http://localhost:3000/api
# 증빙 공유 링크 HMAC 시크릿 (미설정 시 N8N_WEBHOOK_SECRET 사용)
PROOF_SHARE_SECRET=
# 증빙 공유 링크 유효 기간(초). 기본 7일
PROOF_SHARE_TTL_SECONDS=604800

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:3000
VITE_IDLE_TIMEOUT_MS=1800000
CORS_ORIGIN=http://localhost:8080

# --- Misc ---
TZ=Asia/Seoul
