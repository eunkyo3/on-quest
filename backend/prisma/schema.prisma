generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @db.VarChar(120)
  passwordHash  String   @db.VarChar(255)
  name          String   @db.VarChar(80)
  slackMemberId String   @db.VarChar(64)
  companyCode   String   @db.VarChar(32)
  /// role: superadmin | admin | employee — 회사코드 최초 가입자는 superadmin
  role          String   @default("employee") @db.VarChar(20)
  /// 세션 폐기용 버전. 로그아웃 시 증가시켜 발급된 access/refresh 토큰을 즉시 무효화한다.
  tokenVersion  Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@unique([email, companyCode])
  @@unique([slackMemberId, companyCode])
  @@index([companyCode])
  @@map("users")
  // 주의: "한 회사당 superadmin 1명" 보장은 부분 유니크 인덱스
  //   users_one_superadmin_per_company (WHERE role='superadmin') 로 DB 에만 존재한다.
  //   Prisma 스키마 문법으로는 부분 인덱스를 표현할 수 없으므로 마이그레이션
  //   20260609130000_audit_log_and_superadmin_index 가 유일한 정의다.
  //   `prisma db push` 사용 시 이 제약이 사라지므로 반드시 migrate 흐름을 사용할 것.
}

/// 퀘스트 (기존 TypeORM QuestEntity 대응)
/// status v2: 0 대기 / 1 착수 / 2 검토대기 / 3 완료 / 4 반려
/// proofData: 증빙 BLOB — 목록 조회 시에는 select 에서 제외해 성능 유지
model Quest {
  id                     String   @id @db.VarChar(8)
  title                  String   @db.VarChar(120)
  description            String   @db.Text
  deadline               DateTime @db.Timestamptz(6)
  /// status v2: 0 대기 / 1 착수 / 2 검토대기 / 3 완료 / 4 반려 / 5 거부됨(사원이 수행 거부)
  status                 Int      @default(0) @db.SmallInt
  feedback               String?  @db.Text
  /// 사원이 퀘스트를 거부할 때 입력하는 사유
  declineReason          String?  @db.Text
  proofData              Bytes?
  proofMimeType          String?  @db.VarChar(255)
  proofFileName          String?  @db.VarChar(255)
  /// 사원이 증빙과 함께 제출하는 선택 설명
  submissionNote         String?  @db.Text
  assigneeId             String   @db.VarChar(64)
  reviewerId             String?  @db.VarChar(64)
  /// 발행한 관리자의 Slack 멤버 ID (증빙 제출 시 멘션용)
  publisherSlackMemberId String   @db.VarChar(64)
  companyCode            String   @db.VarChar(32)
  deadlineSoonNotifiedAt DateTime? @db.Timestamptz(6)
  overdueNotifiedAt      DateTime? @db.Timestamptz(6)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@index([companyCode])
  @@index([companyCode, assigneeId])
  @@map("quests")
}

/// 감사 로그 — 역할 변경·검토·삭제·거부·재개봉·권한 이양 등 주요 변경 이력
model AuditLog {
  id          String   @id @default(cuid())
  companyCode String   @db.VarChar(32)
  actorId     String   @db.VarChar(40)
  actorName   String   @db.VarChar(80)
  action      String   @db.VarChar(40)
  targetType  String   @db.VarChar(20)
  targetId    String?  @db.VarChar(64)
  detail      String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([companyCode, createdAt])
  @@map("audit_logs")
}
